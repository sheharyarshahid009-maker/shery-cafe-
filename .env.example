# ── Shery Cafe environment ──────────────────────────────────────────────
# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (used by Prisma)
# Example: postgresql://shery:secret@localhost:5432/shery_cafe?schema=public
DATABASE_URL="postgresql://neondb_owner:npg_V6oeftDbiz4O@ep-odd-art-b5paelqv-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Stripe (test mode). Leave STRIPE_SECRET_KEY empty to use the built-in mock
# PaymentIntent flow — the checkout API falls back to a simulated intent.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Admin account used by prisma/seed.ts (bcrypt hash of the admin password)
ADMIN_EMAIL="admin@sherycafe.com"
ADMIN_PASSWORD_HASH="$2a$10$REPLACE_WITH_BCRYPT_HASH"

# Secret used to sign the admin session cookie (min 32 random chars)
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
